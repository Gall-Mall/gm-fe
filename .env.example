# Local API configuration
# mock: 항상 mock / hybrid: 실제 API 실패 시 mock / real: 실제 API 오류를 그대로 표시
VITE_API_MODE=hybrid

# 비워 두면 Vite proxy의 /api, /ws 상대 경로를 사용합니다.
VITE_API_BASE_URL=

# 로컬 Vite proxy가 전달할 백엔드 주소
VITE_BACKEND_URL=http://localhost:8080

# 백엔드 main에는 브라우저 WebSocket 계약이 없어 현재 화면 흐름에서는 사용하지 않습니다.
# 추후 백엔드 STOMP가 제공될 때 사용할 예약 값입니다.
VITE_WS_URL=

# API로 그룹을 생성·선택하기 전 개발 확인에만 사용하는 fallback 그룹 UUID
VITE_ACTIVE_GROUP_ID=

# 실제 API 확인 시 브라우저 세션에 개발용 Access Token을 넣습니다.
# sessionStorage.setItem('gm-access-token', '발급받은 토큰')
# 토큰은 env 파일에 저장하거나 커밋하지 않습니다.

# 카카오 지도 JavaScript 앱 키 (그룹 생성 지도 + 장소검색/주소변환에 사용)
# Kakao Developers > 앱 설정 > 앱 키 > JavaScript 키
# 콘솔 > 플랫폼 > Web 에 사용 도메인(localhost 포함) 등록 필수
VITE_KAKAO_MAP_KEY=
