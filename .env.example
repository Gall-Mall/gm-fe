# Local API configuration
# Leave empty to use the current mock/fallback prototype behavior.
VITE_API_BASE_URL=

# 로컬 Vite proxy가 전달할 백엔드 주소
VITE_BACKEND_URL=http://localhost:8080

# WebSocket endpoint. 비워 두면 VITE_API_BASE_URL에 /ws를 붙여 사용합니다.
VITE_WS_URL=

# 현재 프로토타입에서 투표를 시작할 백엔드 그룹 UUID
VITE_ACTIVE_GROUP_ID=

# Optional explicit mock switch for future API work.
# Current code does not read this yet.
VITE_USE_MOCK=true

# 카카오 지도 JavaScript 앱 키 (그룹 생성 지도 + 장소검색/주소변환에 사용)
# Kakao Developers > 앱 설정 > 앱 키 > JavaScript 키
# 콘솔 > 플랫폼 > Web 에 사용 도메인(localhost 포함) 등록 필수
VITE_KAKAO_MAP_KEY=
